# ---------------------------------------------------------------------------
# Databasus — configuration de la stack
# Copier ce fichier en .env puis adapter :  cp .env.example .env
#
# Ce fichier est lu deux fois :
#   1. par docker compose, pour les ${...} du docker-compose.yml ;
#   2. par le conteneur (env_file), pour les variables applicatives.
# Une ligne commentée n'est PAS injectée dans le conteneur : laisser commenté
# tout ce dont on n'a pas besoin.
#
# Attention : un « $ » dans une valeur doit être doublé « $$ » (interpolation
# docker compose).
# ---------------------------------------------------------------------------


# ===========================================================================
# 1. Paramètres de la stack (lus par docker compose uniquement)
# ===========================================================================

# Image officielle. Miroir GHCR possible si Docker Hub limite les pulls :
#   ghcr.io/databasus/databasus
DATABASUS_IMAGE=docker.io/databasus/databasus

# Version épinglée. La doc amont propose « latest » ; on épingle une version
# pour que le dépôt décrive exactement ce qui tourne.
# Tags disponibles : https://hub.docker.com/r/databasus/databasus/tags
DATABASUS_TAG=v3.70.1

# Nom du conteneur (utile pour les `docker exec` du README).
DATABASUS_CONTAINER_NAME=databasus

# Port publié sur l'hôte pour l'interface web (port interne : 4005).
DATABASUS_PORT=4005

# Adresse d'écoute sur l'hôte.
#   0.0.0.0   = joignable depuis le LAN (usage homelab direct)
#   127.0.0.1 = uniquement en local, à utiliser derrière un reverse proxy
DATABASUS_BIND_ADDRESS=0.0.0.0

# Réseau Docker externe partagé avec les autres stacks à sauvegarder.
# Doit exister avant `docker compose up` :  docker network create databases
DATABASUS_DB_NETWORK=databases

# Fuseau horaire du conteneur (convention Docker, non documentée par Databasus).
TZ=Europe/Paris


# ===========================================================================
# 2. Variables applicatives Databasus
#    Source : https://databasus.com/advanced-config
#    TOUTES OPTIONNELLES — une installation standard n'en a besoin d'aucune.
#    Les destinations de sauvegarde (S3/B2/R2), les bases et les notifications
#    ne se configurent PAS ici mais dans l'interface web.
# ===========================================================================

# --- Connexion Google / GitHub (facultatif, exige HTTPS + domaine public) ---
# Callback à déclarer chez le fournisseur : https://<domaine>/auth/callback
# Le bouton apparaît dès que l'ID est posé, mais la connexion n'aboutit que si
# l'ID ET le secret sont présents.
#GOOGLE_CLIENT_ID=123456789-exemple.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=remplacer-par-le-secret-google
#GITHUB_CLIENT_ID=Iv1exempleclientid
#GITHUB_CLIENT_SECRET=remplacer-par-le-secret-github

# --- Serveur mail de l'instance (invitations, reset de mot de passe, 2FA) ---
# Le mail est considéré comme configuré dès que SMTP_HOST est posé.
# À ne pas confondre avec les notificateurs « email » (réglés dans l'interface).
#SMTP_HOST=smtp.exemple.net
#SMTP_PORT=587
# tls | starttls | none  (défaut : tls sur le port 465, starttls ailleurs)
#SMTP_SECURITY=starttls
#SMTP_USER=databasus@exemple.net
#SMTP_PASSWORD=remplacer-par-le-mot-de-passe-smtp
#SMTP_FROM=Sauvegardes Homelab <databasus@exemple.net>
# Nom annoncé au serveur mail (défaut : hôte de DATABASUS_URL, puis hostname).
#SMTP_HELO_NAME=backup.exemple.net
# true = ne pas vérifier le certificat TLS (certificat auto-signé uniquement).
#SMTP_INSECURE_SKIP_VERIFY=false
# URL publique de l'instance : ajoute un lien dans les emails d'invitation.
#DATABASUS_URL=https://backup.exemple.net

# --- Captcha d'inscription (Cloudflare Turnstile, instance exposée) ---
# Le challenge ne s'active que si les deux clés sont posées.
#CLOUDFLARE_TURNSTILE_SITE_KEY=0x0000000000000000000000
#CLOUDFLARE_TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000000000000

# --- Télémétrie anonyme (activée par défaut en amont) ---
#IS_DISABLE_ANONYMOUS_TELEMETRY=true

# --- Journalisation ---
# debug | info | warn | error  (défaut : info)
#LOG_LEVEL=info
# true (défaut) = écrit databasus.log dans le volume, rotation à 5 Mo, 3 archives.
#LOG_FILE_IS_ENABLED=true
# Export OTLP des logs (http:// et https:// = OTLP/HTTP ; grpc:// et grpcs:// = gRPC).
# Une URL invalide empêche le conteneur de démarrer.
#OPEN_TELEMETRY_URL=http://victoria-logs:9428/insert/opentelemetry/v1/logs
# En-têtes d'authentification, paires key=value séparées par des virgules,
# valeurs percent-encodées (« %20 » pour l'espace).
#OPEN_TELEMETRY_HEADERS=Authorization=Bearer%20remplacer-par-le-token

# --- Script d'analytics injecté dans la page (risque XSS, voir doc amont) ---
#ANALYTICS_SCRIPT=<script defer src="https://exemple.net/script.js"></script>

# --- Identité système sur le volume de données ---
# À ne poser que si le choix automatique (propriétaire du montage, sinon 999)
# ne convient pas : bind mount, partage CIFS, export NFS. Entiers 1..4294967294.
#PUID=1000
#PGID=1000
